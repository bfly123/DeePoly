{
  "problem_type": "general_pde",
  "problem_name": "1D Poisson Steady-State",
  "eq": {
    "L1": [
      "diff(u,x,2)"
    ],
    "L2": [
      "0"
    ],
    "F": [
      "0"
    ],
    "N": [
      "0"
    ],
    "S": [
      "-sin(pi*x)"
    ]
  },
  "vars_list": [
    "u"
  ],
  "spatial_vars": [
    "x"
  ],
  "x_domain": [
    [
      0,
      1
    ]
  ],
  "n_segments": [
    2
  ],
  "poly_degree": [
    10
  ],
  "initial_condition": {
    "method": "spotter",
    "formula": "",
    "spotter_config": {
      "epochs": 500,
      "learning_rate": 0.001,
      "optimizer": "adam",
      "loss_weights": {
        "pde": 1.0,
        "bc": 10.0
      },
      "target_residual": 0.01,
      "print_interval": 100
    }
  },
  "boundary_conditions": [
    {
      "type": "dirichlet",
      "region": "left",
      "value": "0",
      "points": 1
    },
    {
      "type": "dirichlet",
      "region": "right",
      "value": "0",
      "points": 1
    }
  ],
  "reference_solution": "sin(pi*x)/(pi**2)",
  "pseudo_time_stepping": {
    "max_iterations": 5000,
    "convergence_tol": 1e-06,
    "residual_tol": 1e-08,
    "dt_init": 0.01,
    "dt_min": 1e-08,
    "dt_max": 0.5,
    "adaptive_dt": true,
    "dt_increase_factor": 1.2,
    "dt_decrease_factor": 0.5,
    "check_interval": 10,
    "print_interval": 100
  },
  "realtime_visualization": true,
  "animation_skip": 10,
  "save_animation": true,
  "time_scheme": "implicit_euler",
  "device": "cpu"
}