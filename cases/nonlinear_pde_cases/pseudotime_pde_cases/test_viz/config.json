{
    "problem_type": "general_pde",
    "method": "hybrid",
    "eq": {
        "L1": [
            "-0.0001*diff(u,x,2)+diff(u,y)"
        ],
        "L2": [
            "0"
        ],
        "F": [
            "0"
        ],
        "N": [
            "-5*u+5*u**3"
        ],
        "S": [
            "0"
        ]
    },
    "vars_list": [
        "u"
    ],
    "spatial_vars": [
        "x",
        "y"
    ],
    "Initial_conditions": [
        {
            "var": "u",
            "value": "x**2*cos(pi*x)",
            "points": 1000
        }
    ],
    "boundary_conditions": [
        { "type":"dirichlet",
            "region":"left",
            "var":"u",
            "value":-1,
           "points":50},
         { "type":"dirichlet",
            "region":"right",
            "var":"u",
            "value":-1,
            "points":50},
        {
            "type": "dirichlet",
            "region": "bottom",
            "var": "u",
            "formula": "x**2 * cos(pi * x)",
            "points": 50
        }
    ],
    "hidden_dims": [
        8,
        20,
        20
    ],
    "epochs_adam": 100,
    "epochs_lbfgs": 0,
    "max_retries": 1,
    "DNNtol": 0.1,
    "learning_rate": 0.01,
    "n_segments": [
        4,
        3
    ],
    "points_domain": 500,
    "points_per_swap": 10,
    "points_domain_test": [
        50,
        50
    ],
    "poly_degree": [
        5,
        4
    ],
    "x_domain": [
        [
            -1,
            1
        ],
        [
            0,
            1
        ]
    ],
    "pseudo_time": {
        "time_scheme": "implicit_euler",
        "max_iterations": 50,
        "convergence_tol": 0.05,
        "residual_tol": 1e-02,
        "dt_init": 0.1,
        "dt_min": 1e-05,
        "dt_max": 0.11,
        "adaptive_dt": true,
        "dt_increase_factor": 1.2,
        "dt_decrease_factor": 0.5,
        "check_interval": 10,
        "print_interval": 1,
        "save_interval": 100
    },
    "initial_condition": {
        "method": "given"
    },
    "spotter_skip": 1,
    "realtime_visualization": false,
    "animation_skip": 1,
    "device": "cpu",
    "linear_device": "cpu",
    "seed": 42,
    "auto_code": true
}
