{
    "problem_type": "general_pde",
    "method": "hybrid",
    "eq": {
        "L1": ["-diff(u,x,2)"],
        "L2": ["0"],
        "F": ["1"],
        "N": ["u**3"],
        "S": ["pi**2*sin(pi*x) + sin(pi*x)**3"]
    },
    "vars_list": ["u"],
    "spatial_vars": ["x"],
    "boundary_conditions": [
        {
            "type": "dirichlet",
            "region": "left",
            "var": "u",
            "formula": "0",
            "points": 1
        },
        {
            "type": "dirichlet",
            "region": "right",
            "var": "u",
            "formula": "0",
            "points": 1
        }
    ],
    "n_segments": [1],
    "poly_degree": [4],
    "points_domain": 200,
    "points_domain_test": [100],
    "x_domain": [[0, 1]],
    "max_iterations": 30,
    "convergence_tol": 1e-4,
    "print_interval": 5,
    "initial_condition": {
        "method": "zero"
    },
    "device": "cpu",
    "linear_device": "cpu",
    "seed": 42
}
