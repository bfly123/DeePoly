{
  "problem_type": "general_pde",
  "method": "hybrid",
  "eq": {
    "L1": [
      "-0.0001*diff(u,x,2)+diff(u,y)"
    ],
    "L2": [
      "0"
    ],
    "F": [
      "0"
    ],
    "N": [
      "-5*u+5*u**3"
    ],
    "S": [
      "0"
    ]
  },
  "vars_list": [
    "u"
  ],
  "spatial_vars": [
    "x",
    "y"
  ],
  "Initial_conditions": [
    {
      "var": "u",
      "value": "x**2 * cos(pi * x)",
      "points": 10000
    }
  ],
  "boundary_conditions": [
    {
      "type": "dirichlet",
      "region": "left",
      "points": 500,
      "weight": 10,
      "value": -1,
      "var": "u"
    },
    {
      "type": "dirichlet",
      "region": "right",
      "points": 500,
      "weight": 10,
      "value": -1,
      "var": "u"
    },
    {
      "type": "dirichlet",
      "region": "bottom",
      "var": "u",
      "formula": "x**2 * cos(pi * x)",
      "points": 500,
      "weight": 10
    }
  ],
  "hidden_dims": [
    12,
    50,
    50,
    50
  ],
  "learning_rate": 0.01,
  "n_segments": [
    3,
    3
  ],
  "points_domain": 10000,
  "points_per_swap": 10,
  "points_domain_test": [
    200,
    200
  ],
  "poly_degree": [
    9,
    6
  ],
  "x_domain": [
    [
      -1,
      1
    ],
    [
      0,
      1
    ]
  ],
  "pseudo_time": {
    "max_iterations": 30,
    "residual_tol": 1e-6,
    "dt_init": 0.005,
    "dt_min": 0.001,
    "dt_max": 0.005,
    "adaptive_dt": true,
    "print_interval": 1,
    "check_interval": 1,
    "steady_state_mode": false,
    "pseudo_time_direction": -1.0,
    "nonlinear_linearization": "newton",
    "frozen_nonlinear_jacobian": "none"
  },
  "initial_condition": {
    "method": "given"
  },
  "spotter": {
    "train_every": 1,
    "epochs_adam": 10000,
    "epochs_lbfgs": 0,
    "max_retries": 0,
    "tol": 1e-4
  },
  "reference_solution": "../AC_equation/reference_data/allen_cahn_highres.mat",
  "visualization": {
    "dataset_mode": "both",
    "outputs": [
      "spotter",
      "sniper"
    ],
    "reference_policy": "auto",
    "realtime_visualization": false,
    "save_animation": false,
    "animation_skip": 10,
    "figure_dpi": 100,
    "colormap": "RdBu_r"
  },
  "device": "cuda",
  "linear_device": "cuda",
  "linear_method": "gpu_direct",
  "seed": 42,
  "auto_code": false
}
